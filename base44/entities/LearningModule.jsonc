{
  "name": "LearningModule",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05dc\u05d5\u05de\u05d3\u05d4"
    },
    "description": {
      "type": "string",
      "description": "\u05ea\u05d9\u05d0\u05d5\u05e8 \u05d4\u05dc\u05d5\u05de\u05d3\u05d4"
    },
    "url": {
      "type": "string",
      "description": "\u05e7\u05d9\u05e9\u05d5\u05e8 \u05dc\u05d2\u05d9\u05d8\u05d4\u05d0\u05d1"
    },
    "desktop_compatible": {
      "type": "boolean",
      "description": "\u05d4\u05d0\u05dd \u05de\u05d5\u05ea\u05d0\u05de\u05ea \u05dc\u05de\u05d7\u05e9\u05d1"
    },
    "mobile_compatible": {
      "type": "boolean",
      "description": "\u05d4\u05d0\u05dd \u05de\u05d5\u05ea\u05d0\u05de\u05ea \u05dc\u05de\u05d5\u05d1\u05d9\u05d9\u05dc"
    },
    "slug": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d9\u05d9\u05d7\u05d5\u05d3\u05d9 \u05dc\u05e0\u05d9\u05d5\u05d5\u05d8"
    },
    "category": {
      "type": "string",
      "enum": [
        "military",
        "civilian",
        "immersive"
      ],
      "description": "\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d9\u05ea \u05d4\u05dc\u05d5\u05de\u05d3\u05d4"
    },
    "disabled": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05d4\u05dc\u05d5\u05de\u05d3\u05d4 \u05de\u05d5\u05e9\u05d1\u05ea\u05ea"
    }
  },
  "required": [
    "name",
    "url",
    "slug",
    "category"
  ]
}